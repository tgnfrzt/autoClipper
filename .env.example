# ==========================================
# GTA VI AI AutoClipper Configuration
# ==========================================
# Copy to .env or configure via the Web UI (http://localhost:17430 -> Configure)

HOST=0.0.0.0
PORT=17430
DEBUG=false

# --- Stream Monitoring & Discovery ---
GAME_QUERY=Grand Theft Auto VI
FALLBACK_GAME_QUERY=Grand Theft Auto V
AUTO_DISCOVER_TWITCH=true
AUTO_DISCOVER_YOUTUBE=true
PREFER_FACECAM_STREAMS=true
MAX_CONCURRENT_STREAMS=15
STREAM_QUALITY=720p,480p,best
DISCOVERY_INTERVAL_SEC=120

# --- 80/20 Hype Detection Engine ---
CHAT_WEIGHT=0.80
VISUAL_WEIGHT=0.20
TRIGGER_SCORE_THRESHOLD=70.0
CLIP_DURATION_SEC=45
POST_TRIGGER_DELAY_SEC=4
CLIP_COOLDOWN_SEC=60
VISUAL_EVAL_INTERVAL_SEC=4
SEGMENT_DURATION_SEC=3

# --- Local AI Vision (VLM) ---
# Provider: llamacpp | openai | opencv_only
VLM_PROVIDER=llamacpp
VLM_API_URL=http://127.0.0.1:8081/v1
VLM_API_KEY=
VLM_MODEL_NAME=Qwen2.5-VL-3B-Instruct (Q4_K_M)
LLAMA_SERVER_EXE=
VLM_MODEL_PATH=
VLM_MMPROJ_PATH=
VLM_PORT=8081
VLM_AUTO_START=true

# --- Video Output & Smart 9:16 Gaming Split ---
# VIDEO_FORMAT_MODE: smart_gaming_split | blurred_9_16 | original_16_9
VIDEO_FORMAT_MODE=smart_gaming_split
# FACECAM_POSITION: auto | top_left | top_right | bottom_left | bottom_right | none
FACECAM_POSITION=auto
BURN_IN_CAPTIONS=true
ANTI_FINGERPRINT=true
WATERMARK_ALPHA=0.9

# --- Discord Integration (Webhook URL Recommended, or Optional Bot) ---
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_USER_ID=
DISCORD_COMMAND_PREFIX=!
AUTO_DELETE_ON_REJECT=true

# --- Optional Twitch Helix API (Anonymous public GQL works without these) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Social Publishing Credentials (Inspired by AutoPoster) ---
# YouTube Shorts uses storage/data/client_secret.json + OAuth in the Configure UI
YOUTUBE_DEFAULT_PRIVACY=public
DEFAULT_YOUTUBE_CAPTION=Insane GTA VI moment! #GTA6 #GTAVI #Shorts #Gaming #Viral

# TikTok (Session ID cookie or tiktok_cookies.txt or Official API Token)
TIKTOK_SESSION_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
DEFAULT_TIKTOK_CAPTION=Wait for the ending 😭🔥 #GTA6 #GTAVI #Gaming #FYP #Viral

# Instagram Reels (Meta Graph API + Temporary Public Hosting Relay)
INSTAGRAM_BUSINESS_ID=
PAGE_ACCESS_TOKEN=
REMOTE_HOSTING_URL=
DEFAULT_INSTAGRAM_CAPTION=GTA VI is already wild 🤯🔥 #GTA6 #GTAVI #Reels #Gaming #Viral
